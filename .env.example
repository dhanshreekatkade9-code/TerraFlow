# NUGEN AI configuration for TerraFlow (Smart Irrigation Advisor)
# Copy this file to .env and fill in the values from your Nugen dashboard/docs.
# NEVER put a real key in this file: .env.example is committed to Git, .env is not.

NUGEN_API_KEY=nugen-74245bd5b9bb34e6
NUGEN_API_URL=https://api.nugen.in/api/v3/inference/chat/completions
NUGEN_MODEL=meta-llama/Llama-3.2-3B-Instruct
# 1 = the server refuses to start without Nugen (use this for the demo).
# 0 = local development without a key (built-in fallback text is shown and labelled).
NUGEN_REQUIRED=1
